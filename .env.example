# Backend Environment Variables
# Copy this file to .env and set your values
# The .env file is gitignored and will not be committed
# For frontend build-time variables, see frontend/.env.example

# ============================================
# Runtime Variables (Backend/Node.js)
# ============================================
# These variables are used at runtime by the backend server
# They can be set in ecosystem.config.js (for PM2) or as environment variables

# Node environment (development or production)
# NODE_ENV=production

# Server host (0.0.0.0 for network access, 127.0.0.1 for localhost only)
# HOST=0.0.0.0

# Server port (default: 33101)
# PORT=33101

# Frontend port — used by backend for CORS and by scripts (default: 33100)
# FRONTEND_PORT=33100

# Frontend URL for CORS validation (optional)
# FRONTEND_URL=http://localhost:33100

# Multiple frontend URLs (comma-separated)
# FRONTEND_URLS=http://localhost:33100,http://192.168.1.100:33100

# Feedback moderation master PIN (required for /api/feedback/verify-pin
# and /api/feedback/:id/close endpoints)
# FEEDBACK_MASTER_PIN=change-this-to-a-strong-pin
