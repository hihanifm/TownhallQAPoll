# Frontend Build-time Variables (Vite)
# Copy this file to .env.production and set your values
# These variables are embedded into the frontend bundle during build

# Enable browser restriction in production
# Set to 'true' to restrict access to specific browsers (see browserConfig.js)
# Only applies in production mode
VITE_ENABLE_BROWSER_RESTRICTION=false

# API URL for frontend dev proxy (optional; dev backend default http://localhost:33112)
# VITE_API_URL=http://localhost:33112
